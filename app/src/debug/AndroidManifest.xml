<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug-only entry point for driving the first-run assistant from a workstation:

              adb shell am start -a com.iblu01.portallauncher.action.ONBOARDING

            Add the boolean extra "reset" (ez) to wipe the stored progress first; see README.

            Lives in the debug source set on purpose: OnboardingActivity itself stays
            android:exported="false" in the shipped manifest, so no third-party app can pop the
            assistant — or reset its progress — on a real panel.
        -->
        <activity-alias
            android:name=".ui.onboarding.OnboardingDevTrigger"
            android:targetActivity=".ui.onboarding.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.iblu01.portallauncher.action.ONBOARDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
            Same idea for the settings, so a panel's configuration can be inspected without
            walking the launcher's gestures:

              adb shell am start -a com.iblu01.portallauncher.action.SETTINGS
        -->
        <activity-alias
            android:name=".SettingsDevTrigger"
            android:targetActivity=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.iblu01.portallauncher.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
            Remote-configuration screen, for testing the QR code and the LAN server without
            walking the settings on a keyboard-less panel:

              adb shell am start -a com.iblu01.portallauncher.action.WEB_CONFIG

            Debug-only: on a real panel WebConfigActivity stays android:exported="false", so no
            third-party app can make it serve this home's credentials on the network.
        -->
        <activity-alias
            android:name=".WebConfigDevTrigger"
            android:targetActivity=".WebConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.iblu01.portallauncher.action.WEB_CONFIG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Debug-only ADB entry point used by the Playground option in dev.sh. -->
        <activity-alias
            android:name=".PlaygroundDevTrigger"
            android:targetActivity=".PlaygroundActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.iblu01.portallauncher.action.PLAYGROUND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
